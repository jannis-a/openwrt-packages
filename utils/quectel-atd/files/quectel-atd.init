#!/bin/sh /etc/rc.common
# quectel-atd: keeps the connection to the Quectel module's AT port open and
# shares it over /var/run/quectel-at.sock (client: quectel-at).

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/quectel-atd
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
