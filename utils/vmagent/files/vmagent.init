#!/bin/sh /etc/rc.common
# vmagent: scrapes the targets in its scrape config and pushes the samples to
# a Prometheus remote write endpoint (/etc/config/vmagent). While the endpoint
# is unreachable it buffers under data_path and sends the backlog later.
# Restart after editing the scrape config.

START=99
USE_PROCD=1

PROG=/usr/bin/vmagent

start_service() {
	local enabled url auth_header auth_header_file listen scrape_config data_path max_disk_usage

	config_load vmagent
	config_get_bool enabled main enabled 0
	config_get url main remote_write_url
	config_get auth_header main auth_header
	config_get auth_header_file main auth_header_file
	config_get listen main listen 127.0.0.1:8429
	config_get scrape_config main scrape_config /etc/vmagent/scrape.yml
	config_get data_path main data_path /var/lib/vmagent
	config_get max_disk_usage main max_disk_usage 1GB

	[ "$enabled" = 1 ] || return 0
	if [ -z "$url" ]; then
		logger -t vmagent "remote_write_url is not set, not starting"
		return 1
	fi
	mkdir -p "$data_path"

	procd_open_instance
	procd_set_param command "$PROG" \
		-envflag.enable \
		-httpListenAddr="$listen" \
		-promscrape.config="$scrape_config" \
		-remoteWrite.url="$url" \
		-remoteWrite.tmpDataPath="$data_path" \
		-remoteWrite.maxDiskUsagePerURL="$max_disk_usage"
	# The header goes in via the environment so the secret does not show up in ps.
	if [ -n "$auth_header" ] && [ -n "$auth_header_file" ]; then
		procd_set_param env remoteWrite_headers="$auth_header:$(cat "$auth_header_file")"
	fi
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger vmagent
}
