config vmagent 'main'
	# Starts only when enabled and remote_write_url is set.
	option enabled '0'
	option remote_write_url ''
	# Optional header with a secret from a file (mode 600), e.g. an API key:
	# sent as "<auth_header>: <contents of auth_header_file>".
	option auth_header ''
	option auth_header_file ''
	option listen '127.0.0.1:8429'
	option scrape_config '/etc/vmagent/scrape.yml'
	# Disk buffer while the endpoint is unreachable. /var is tmpfs, so the
	# backlog is lost on reboot; point it at persistent storage to keep it.
	option data_path '/var/lib/vmagent'
	option max_disk_usage '1GB'
